MONGODB_URI=mongodb://localhost:27017/smartcare
JWT_SECRET=your_secret_key_here
OPENAI_MODEL=gpt-3.5-turbo
# If using OpenAI, set this. Leave blank if not using OpenAI.
OPENAI_API_KEY=
# If using Google Gemini, set your API key here. Example keys often start with "AIza".
# Leave blank if you do not want to use Gemini.
GEMINI_API_KEY=
# When true (default), server will fall back to OpenAI if Gemini fails.
# Set to "false" to force Gemini-only behavior when a Gemini key exists.
ALLOW_OPENAI_FALLBACK=true
PORT=3001
CLIENT_URL=http://localhost:3000

# Note: Do NOT commit a real .env file with secret keys to git.# Rename this file to .env in development
# Keep secrets out of source control

MONGODB_URI=mongodb://localhost:27017/smartcare
JWT_SECRET=your_secret_key_here

# AI API Configuration (use one of these)
# Option 1: OpenAI GPT-4 or GPT-3.5-turbo
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Option 2: Google Gemini 1.5 Pro
GEMINI_API_KEY=your_gemini_api_key_here

PORT=3001
CLIENT_URL=http://localhost:3000
